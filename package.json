{
  "name": "suluan",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "workspaces": [
    "apps/*",
    "packages/*"
  ],
  "scripts": {
    "dev": "npm run dev -w web",
    "dev:worker": "npm run dev -w @suluan/worker",
    "dev:worker:remote": "npm run dev:remote -w @suluan/worker",
    "build": "npm run build -w web",
    "preview": "npm run preview -w web",
    "lint": "npm run lint --workspaces --if-present",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "test": "npm run test --workspaces --if-present",
    "test:watch": "npm run test:watch --workspaces --if-present",
    "check": "npm run lint && npm run typecheck && npm run test",
    "db:generate": "npm run generate -w @suluan/db",
    "db:migrate": "npm run migrate -w @suluan/db",
    "db:check": "npm run check:db -w @suluan/db",
    "db:promote-admin": "npm run promote-admin -w @suluan/db",
    "db:seed:dev": "npm run seed:dev -w @suluan/db",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "devDependencies": {
    "prettier": "^3.9.9"
  }
}
