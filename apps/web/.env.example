# Frontend runtime config — placeholders only. Never commit real secrets.
# Vite exposes only VITE_* vars to the browser; anything here is public by definition.
# Firebase public config arrives in Stage 2; API base points at the local Worker (built at the submission/review stage).
VITE_API_BASE_URL=http://localhost:8787
VITE_FIREBASE_API_KEY=
VITE_FIREBASE_AUTH_DOMAIN=
VITE_FIREBASE_PROJECT_ID=
