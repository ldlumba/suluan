# Staging placeholders only. Copy to `.dev.vars.staging` if an operator needs
# local tooling to read the values; that file is git-ignored. Remote Worker
# values are set with `wrangler secret put -c wrangler.staging.toml`.
# Never add GEMINI_API_KEY: Gemini calls belong only to regional Cloud Run.
# Gmail sender secrets (owner-approved 2026-10-05, temporary UA mailbox).
# Values live only in Worker secrets; see docs/gmail-notifications.md.
DATABASE_URL=
FIREBASE_PROJECT_ID=suluan-staging
SEMANTIC_SEARCH_MODE=hybrid
SEMANTIC_DISCOVERY_MAX_SCORE=0.40
PROCESSING_SERVICE_AUDIENCE=https://suluan-api-staging.ctrlfinder.workers.dev
PROCESSING_SERVICE_ACCOUNT=suluan-processing-staging@suluan-staging.iam.gserviceaccount.com
GMAIL_CLIENT_ID=
GMAIL_CLIENT_SECRET=
GMAIL_REFRESH_TOKEN=
GMAIL_SENDER=
# Assistant is keyless/disabled until its registered live gate passes. These
# are non-secret remote vars, preserved with wrangler deploy --keep-vars.
ASSISTANT_SERVICE_URL=
ASSISTANT_SERVICE_ACCOUNT=
ASSISTANT_SERVICE_AUDIENCE=
ASSISTANT_PILOT_EMAILS=
# Optional contact email for the Crossref polite pool; falls back to the
# REO mailbox when empty.
DOI_CONTACT_EMAIL=
