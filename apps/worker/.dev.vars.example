# Local dev only. wrangler dev auto-loads this file; NEVER commit it.
# Production values become `wrangler secret`s at deploy time, not vars here.
#
# DATABASE_URL: Neon HTTP driver accepts the pooled OR direct endpoint.
# Use the pooled (-pooler) endpoint for serverless runtime efficiency.
# FIREBASE_PROJECT_ID: must match the Firebase project issuing ID tokens
# (tokens carry aud = project ID; mismatch means rejection).
# ALLOWED_DOMAINS: comma-separated; see Architecture v1 §12 (ua.edu.ph only).
DATABASE_URL=
FIREBASE_PROJECT_ID=
ALLOWED_DOMAINS=ua.edu.ph
# Optional exact-email evaluation exception. Keep empty unless an owner-approved
# test is active; both values are required and malformed/expired config denies.
EVALUATION_EMAILS=
EVALUATION_ACCESS_EXPIRES_AT=
# Local frontend origin. Add more comma-separated origins if you serve the
# frontend on another port; production sets this via the dashboard instead.
ALLOWED_ORIGINS=http://localhost:5173
# Cloud Run Job workload identity. Leave empty until the dedicated service
# account and deployed Worker audience exist; no private key is stored here.
PROCESSING_SERVICE_AUDIENCE=
PROCESSING_SERVICE_ACCOUNT=
# Gmail sender (owner-approved 2026-10-05, temporary UA mailbox). All four are
# Worker secrets in deployed environments; keep empty locally unless testing
# delivery. Never commit values. See docs/gmail-notifications.md.
GMAIL_CLIENT_ID=
GMAIL_CLIENT_SECRET=
GMAIL_REFRESH_TOKEN=
GMAIL_SENDER=
# Optional research assistant. Keep unset until the target environment passes
# its registered gate; never put the regional service's Gemini key here.
ASSISTANT_SERVICE_URL=
ASSISTANT_SERVICE_ACCOUNT=
ASSISTANT_SERVICE_AUDIENCE=
# Exact owner-confirmed eligible pilot emails, comma-separated. Empty denies all.
ASSISTANT_PILOT_EMAILS=
# Optional contact email for the Crossref polite pool (User-Agent/mailto).
# Falls back to the REO mailbox when empty; DOI enrichment works either way.
DOI_CONTACT_EMAIL=
